generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  telegramId      BigInt    @unique @map("telegram_id")
  username        String?
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  languageCode    String?   @map("language_code")
  isPremium       Boolean?  @map("is_premium")
  photoUrl        String?   @map("photo_url")
  isOrganizer     Boolean   @default(false) @map("is_organizer")
  balance         Int       @default(0)
  phoneHash       String?   @unique @map("phone_hash")
  allowContactMatching Boolean @default(false) @map("allow_contact_matching")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  businessCards   BusinessCard[]
  contacts        Contact[]
  referrals       Referral[]
  referredBy      Referral[] @relation("ReferredUsers")
  events          Event[]
  eventRegistrations EventRegistration[]
  referralLogsAsUser    ReferralLog[] @relation("ReferralLogUser")
  referralLogsAsReferrer ReferralLog[] @relation("ReferralLogReferrer")

  // New mandates
  subscription    Subscription?
  cryptoPayments  CryptoPayment[]
  bqgs            BQG[]
  trustInteractions TrustInteraction[] @relation("UserTrust")
  rituals         ReviewRitual[]
  networkSnapshots NetworkHealthSnapshot[]
  meetings        Meeting[]

  @@map("users")
}

model Subscription {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique @map("user_id")
  plan        String    @default("free") // free, premium
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")
  trialStart  DateTime? @map("trial_start")
  trialEnd    DateTime? @map("trial_end")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments    CryptoPayment[]

  @@map("subscriptions")
}

enum CryptoPaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

model CryptoPayment {
  id            String   @id @default(cuid())
  userId        Int      @map("user_id")
  invoiceId     String   @unique @map("invoice_id") // Crypto Pay invoice_id
  amountUsd     Float    @map("amount_usd")
  amountUsdt    Float    @map("amount_usdt")
  asset         String   // "USDT"
  status        CryptoPaymentStatus @default(PENDING)
  payload       String   // JSON string with plan info
  confirmedAt   DateTime? @map("confirmed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId Int?    @map("subscription_id")

  @@map("crypto_payments")
}

model BQG {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  goal          String
  missingRoles  String?   @map("missing_roles") // JSON array of missing roles
  quarterStart  DateTime  @map("quarter_start")
  quarterEnd    DateTime  @map("quarter_end")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bqgs")
}

model Contact {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  contactId   String    @map("contact_id")
  businessName String?  @map("business_name")
  resources   String?
  personalData String?  @map("personal_data")

  // New mandates
  circle        String?   @default("productivity") // support, productivity, development
  archetype     String?   // peach, pomegranate, apple
  aiSuggestedRole String? @map("ai_suggested_role") // connector, condensator, bridge, gatekeeper
  privateMeta   String?   @map("private_meta") // encrypted ОИС tags
  lastInteraction DateTime? @map("last_interaction")
  isActive      Boolean   @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trustInteractions TrustInteraction[] @relation("ContactTrust")

  @@unique([userId, contactId])
  @@map("contacts")
}

model TrustInteraction {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  contactId     Int       @map("contact_id")
  type          String    // you_helped, they_helped, mutual
  description   String?
  balanceDelta  Int       @default(0) @map("balance_delta") // -100 to +100
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, name: "UserTrust")
  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade, name: "ContactTrust")

  @@map("trust_interactions")
}

model ReviewRitual {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  startedAt     DateTime  @map("started_at")
  completedAt   DateTime? @map("completed_at")
  metrics       String?   // JSON: contactsReviewed, archived, unfrozen, etc.
  status        String    @default("in_progress") // in_progress, completed, abandoned
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("review_rituals")
}

model NetworkHealthSnapshot {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  density       Float?
  diversity     Float?
  freshness     Float?
  trustBalance  Int       @default(0) @map("trust_balance")
  totalContacts Int       @default(0) @map("total_contacts")
  activeContacts Int      @default(0) @map("active_contacts")
  supportCircle Int       @default(0) @map("support_circle")
  productivityCircle Int  @default(0) @map("productivity_circle")
  developmentCircle Int   @default(0) @map("development_circle")
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("network_health_snapshots")
}

model BusinessCard {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  contactId   String    @unique @map("contact_id")
  businessName String?  @map("business_name")
  resources   String?   @map("resources")
  personalData String?  @map("personal_data")
  qrCodeUrl   String?   @map("qr_code_url")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_cards")
}

model Referral {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  referrerId  Int       @map("referrer_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrer    User      @relation("ReferredUsers", fields: [referrerId], references: [id], onDelete: Restrict)

  @@unique([userId, referrerId])
  @@map("referrals")
}

model ReferralLog {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  referrerId  Int       @map("referrer_id")
  action      String
  points      Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, name: "ReferralLogUser")
  referrer    User      @relation(fields: [referrerId], references: [id], onDelete: Cascade, name: "ReferralLogReferrer")

  @@map("referral_logs")
}

model Event {
  id          Int       @id @default(autoincrement())
  organizerId Int       @map("organizer_id")
  title       String
  description String?
  location    String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organizer   User      @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id          Int       @id @default(autoincrement())
  eventId     Int       @map("event_id")
  userId      Int       @map("user_id")
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_registrations")
}

model Meeting {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  contactId       Int       @map("contact_id")
  location        String?
  scheduledAt     DateTime? @map("scheduled_at")
  actualAt        DateTime? @map("actual_at")
  status          String    @default("planned") // planned, in_progress, completed, cancelled
  anchors         String?   // JSON: conversation anchors/topics to discuss
  notes           String?   // notes during meeting
  outcomes        String?   // JSON: outcomes, action items, follow-ups
  followUpDate    DateTime? @map("follow_up_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("meetings")
}
