# Database
DATABASE_URL="postgresql://radar:radar_password@localhost:5433/radar_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=https://radar.strateg.space/webhook

# SOCKS5 Proxy for Telegram API (Finland server)
SOCKS_PROXY_HOST=127.0.0.1
SOCKS_PROXY_PORT=1080

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d

# Encryption (AES-256-GCM for private contact metadata)
ENCRYPTION_KEY=your_encryption_key_here_64_hex_chars

# Application
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=52428800

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# Crypto Pay (CryptoBot)
CRYPTOPAY_APP_ID=your_app_id
CRYPTOPAY_APP_TOKEN=your_app_token
CRYPTOPAY_WEBHOOK_SECRET=your_webhook_secret
CRYPTOPAY_API_URL=https://pay.crypt.bot/api
CRYPTOPAY_TESTNET=false

# Site URL
SITE_URL=https://radar.strateg.space
